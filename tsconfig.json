{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "ES2018"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "target": "ES2018",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
