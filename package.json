{
  "name": "knowledge-base-command-center",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "description": "Configurable visual knowledge index, note creator, collections, and smart queues for Obsidian.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drbinsaad/knowledge-base-command-center.git"
  },
  "bugs": {
    "url": "https://github.com/drbinsaad/knowledge-base-command-center/issues"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test tests/model.test.ts",
    "test:release": "node --experimental-strip-types --test tests/release.test.ts",
    "check": "npm test && npm run lint && npm run build && npm run test:release",
    "release:bundle": "npm run check && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.1"
  }
}
