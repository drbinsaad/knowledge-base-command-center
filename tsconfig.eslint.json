{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mjs",
    "scripts/**/*.mjs",
    "*.mjs"
  ]
}
