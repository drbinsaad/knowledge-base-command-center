{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules", ".claude", "dist", "tests/browser/**", "tests/layout/**", "tests/**/._*"]
}
